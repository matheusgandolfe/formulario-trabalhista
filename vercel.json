{
  "rewrites": [
    { "source": "/interno", "destination": "/index.html" },
    { "source": "/lista", "destination": "/lista.html" },
    { "source": "/:slug([a-z0-9-]+-v\\d+)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
